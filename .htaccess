# HTML e PHP sempre revalidados: atualizações do site aparecem na hora
<IfModule mod_headers.c>
  <FilesMatch "\.(html|php)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
<IfModule LiteSpeed>
  CacheLookup off
</IfModule>

# Scale News: /scale-news sempre aponta para a edição mais recente (atualizar a cada edição)
RedirectMatch 302 ^/scale-news/?$ /news/04/
